# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Адрес сайта для ссылок в письмах и сообщениях.
# Для проверки на ПК — адрес в вашей сети, на сервере — https://warpflow.ru
WARPFLOW_PUBLIC_URL=http://192.168.1.48:5173

# Unisender Go: API-ключ (домен warpflow.ru должен быть подтверждён в кабинете)
UNISENDER_API_KEY=
WARPFLOW_MAIL_FROM=no-reply@warpflow.ru

# Telegram: с https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Sends per hour per IP for each channel (email / Telegram); raise it for local testing
# WARPFLOW_MAX_SENDS_PER_HOUR=5

# Stats site (st.warpflow.ru): a long password; the login can be anything
WARPFLOW_STATS_PASSWORD=
